/**
 * VIBECODE CLEAN FLAT VIBE - NETWORK (RONEMA)
 **/

* {
    deep-blue:    #0d111cf9; /* Leicht transparent */
    text-light:   #e0e5f5;   
    cyber-pink:   #f05ca0;
    soft-blue:    #1a2133;
    cyber-purple: #b072d1;

    background-color: transparent;
    text-color:       @text-light;
    
    /* Strikt Nunito Bold */
    font:             "Nunito Bold 11";
}

window {
    background-color: @deep-blue;
    border:           2px solid;
    border-color:     @cyber-purple;
    border-radius:    8px; /* Systemweiter Außenradius */
    width:            350px; 
    
    location:         north east;
    anchor:           north east;
    
    x-offset:         -80px; 
    y-offset:         0px;
}

mainbox {
    padding:          8px;
    spacing:          8px;
    children:         [ "inputbar", "listview" ];
}

inputbar {
    background-color: @soft-blue;
    border-radius:    4px; /* Schärfere Innenkanten */
    padding:          6px 10px;
    children:         [ "entry" ];
}

entry {
    font:               "Nunito Bold 11";
    placeholder:        "Search Networks...";
    placeholder-color:  #e0e5f544; /* text-light mit Alpha */
}

/* --- LISTE --- */
listview {
    fixed-height:     false;
    lines:            8;
    spacing:          2px;
    scrollbar:        false;
}

element {
    padding:          4px 8px;
    border-radius:    4px; /* Schärfere Innenkanten */
}

element selected {
    background-color: @cyber-pink;
    text-color:       #0d111c; /* Deep Blue Text auf Pink */
}

element-text {
    font:           "JetBrainsMono Nerd Font Bold 10"; 
    vertical-align: 0.5;
    text-color:     inherit;
}

element-icon {
    size:           18px;
    margin:         0 8px 0 0;
}