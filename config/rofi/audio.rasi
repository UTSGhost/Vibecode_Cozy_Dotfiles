/** --- CLEAN FLAT VIBE AUDIO (MINI) --- **/
* {
    deep-blue:    #0d111cf9; /* Leicht transparent */
    text-light:   #e0e5f5;   
    cyber-pink:   #f05ca0;
    cyber-purple: #b072d1;
    soft-blue:    #1a2133;

    background-color: transparent;
    text-color: @text-light;
    font: "Nunito Bold 10";
}

window {
    background-color: @deep-blue;
    border: 2px solid;
    border-color: @cyber-purple;
    border-radius: 8px; /* Systemweiter Außenradius */
    width: 220px; /* Schön schmal */
    
    location: north east;
    anchor: north east;
    x-offset: -360px; /* Deine gewohnte Positionierung */
    y-offset: 0px;    
}

mainbox {
    padding: 4px;
    children: [ "listview" ]; /* Inputbar entfernt für maximale Kompaktheit */
}

listview {
    fixed-height: false;
    lines: 5; /* Maximal 5 Geräte gleichzeitig sichtbar */
    scrollbar: false;
    spacing: 2px; /* Minimaler Abstand für den sauberen Look */
}

element {
    padding: 6px 10px;
    border-radius: 4px; /* Schärfere Innenkanten */
}

element selected {
    background-color: @cyber-pink;
    text-color: #0d111c; /* Deep Blue Text auf Pink für den krassen Kontrast */
}

element-text {
    font: "JetBrainsMono Nerd Font Bold 9";
    text-color: inherit; /* Erbt die Textfarbe beim Hovern/Auswählen */
}